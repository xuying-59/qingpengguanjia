<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="农资购物入口" android:textColor="@color/forest"
            android:textStyle="bold" android:textSize="25sp"/>
        <include layout="@layout/view_crop_carousel"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="输入农药或农资关键词，选择平台查看商品。购买、支付及售后均在电商平台完成。"
            android:textColor="@color/muted" android:textSize="15sp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:hint="搜索关键词"
            app:boxBackgroundMode="outline">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/shop_search_query" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="text"
                android:singleLine="true" android:text="农药"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/shop_taobao" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="在淘宝搜索"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/shop_jd" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="在京东搜索"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="请核对商品登记信息、适用作物及使用说明，并遵守当地购买和使用要求。"
            android:textColor="@color/muted" android:textSize="13sp"/>
    </LinearLayout>
</ScrollView>
